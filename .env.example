# =============================================================================
# Shopifind — Environment variables template
# Copy to .env.local and fill in real values.
# NEVER commit .env.local to git.
# =============================================================================

# ---- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Server-only. NEVER expose to client. Used by cron / ingest.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_PROJECT_ID=YOUR_PROJECT

# ---- Skimlinks (Affiliate) --------------------------------------------------
# Get these from https://hub.skimlinks.com/ after you sign up as a Publisher.
SKIMLINKS_API_KEY=
SKIMLINKS_DOMAIN_ID=

# ---- OpenAI (for conversational search in V1+) -----------------------------
OPENAI_API_KEY=sk-...

# ---- Resend (for transactional email — alerts, newsletter) ------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@shopifind.app

# ---- Plausible Analytics ----------------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=shopifind.app

# ---- App --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://shopifind.app
