{
  "name": "shopifind",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "description": "B2C multi-niche product discovery search engine (moda sostenible, gadgets indie, deco/hogar)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint . --ext .js,.mjs,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "check": "eslint . --ext .js,.mjs,.ts,.tsx && tsx --test tests/*.test.ts && tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,json}\"",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > src/types/database.types.ts",
    "scripts:seed:collection": "tsx scripts/seed-editorial-collection.ts",
    "scripts:seed:products": "tsx scripts/seed-products-v2.ts",
    "scripts:seed:lighting": "tsx scripts/seed-lighting-v1.ts",
    "scripts:seed:lighting:collections": "tsx scripts/seed-lighting-collections-v1.ts",
    "scripts:fix:urls": "tsx scripts/fix-source-urls.ts",
    "scripts:hide:placeholder": "tsx scripts/hide-placeholder-rows.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.43.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.376.0",
    "next": "^15.5.22",
    "openai": "^4.47.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.51.4",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@typescript-eslint/typescript-estree": "^8.64.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.22",
    "playwright-core": "^1.62.0",
    "postcss": "^8.5.19",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5"
  }
}
