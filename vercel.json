{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/refresh-masterled",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron/process-price-alerts",
      "schedule": "15 4 * * *"
    }
  ]
}
